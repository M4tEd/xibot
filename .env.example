# --- Discord ---
DISCORD_BOT_TOKEN=
# Optional bootstrap for one server (both or neither). When set, that
# guild->channel mapping is upserted at every startup. Every additional
# server configures itself in Discord with /songbot-setup.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# --- Catalog sources ---
YOUTUBE_PLAYLIST_URL=
LOCAL_MUSIC_DIR=

# --- Game config ---
DAILY_POST_TIME=12:00
TIMEZONE=America/Halifax
MAX_GUESSES_PER_DAY=6
SNIPPET_LENGTHS=1,2,4,8,16
SNIPPET_POINTS=100,75,50,30,15
BOTH_CORRECT_MULTIPLIER=1.5
# What counts as a correct guess: "either" (title OR artist; the 1.5x
# both-fields bonus applies), "title", or "artist". Use "artist" for a
# single-artist catalog where only the artist name matters.
GUESS_MATCH_MODE=either

# --- Storage & runtime ---
DATABASE_PATH=./data/songbot.db
SNIPPET_CACHE_DIR=./data/snippets
HEALTH_PORT=3108
LOG_LEVEL=INFO

# Optional: Discord API base override for off-machine live runs.
# DISCORD_API_BASE=https://discord.com/api/v10
